# Copy to .env and fill in your keys:  cp .env.example .env
# Everything below is read by the backend at import time (constants.py -> load_dotenv()).

# --- Required for real agent runs (Chat tab, research/profile/draft nodes) ---
# https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# --- Required for email enrichment (Hunter.io) + the Hunter quota card in Usage & Spend ---
# https://hunter.io/api-keys
HUNTER_API_KEY=

# --- Optional: phone enrichment. Leave PHONE_PROVIDER unset to make no phone lookups. ---
# PHONE_PROVIDER=datagma        # datagma | prospeo
# DATAGMA_API_KEY=
# PROSPEO_API_KEY=

# --- Search depth: web-search iterations per node call (defaults shown) ---
# Higher = deeper research, but more billed web searches and slower runs.
# FIND_SEARCH_MAX_USES=20       # lead discovery searches per chat message
# RESEARCH_SEARCH_MAX_USES=8    # searches per company
# PROFILE_SEARCH_MAX_USES=10    # searches per person
# PROFILE_LEAD_LIMIT=15         # how many leads get an individual profile pass

# --- Optional overrides (defaults shown) ---
# ANTHROPIC_MODEL=claude-sonnet-4-5
# ANTHROPIC_MAX_TOKENS=4096
# LEADS_DB_PATH=leads.db        # leads, settings, usage_events
# AGENT_DB_PATH=agent.db        # LangGraph conversation checkpoints

# Slack / SMTP notifications and the Anthropic admin key for billed spend are
# configured in the UI Settings tab, not here.
